; Engine configuration file.
config_version=5

[application]

config/name="La Guerre des Cartes"
config/description="RTS + deckbuilding — Prototype 1 : carte, déplacements, sélection, combats."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.3")

[display]

window/size/viewport_width=1672
window/size/viewport_height=941
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"


[gui]

theme/custom="res://assets/ui/theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
